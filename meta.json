{
  "id": "H8eW8uubGfEY",
  "name": "toolkits",
  "type": "app",
  "routines": {
    "init_herdr": "run herdr init toolkits",
    "attach_herdr": "run herdr attach toolkits",
    "terminate_herdr": "run herdr terminate toolkits",
    "claude_marketplace_add": "claude plugin marketplace add ./",
    "claude_marketplace_add_remote": "claude plugin marketplace add ghostmind-labo/toolkits"
  },
  "herdr": {
    "workspaces": [
      {
        "label": "toolkits",
        "tabs": [
          {
            "label": "claude",
            "layout": "compact",
            "compact": {
              "type": "single",
              "panes": [
                {
                  "name": "main",
                  "description": "Claude Code session for this project",
                  "focus": true
                }
              ]
            }
          },
          {
            "label": "shell",
            "layout": "compact",
            "compact": {
              "type": "two-by-two",
              "panes": [
                {
                  "name": "server",
                  "description": "long-running dev server, do not interrupt"
                },
                {
                  "name": "build",
                  "description": "builds, installs and other long-running tasks"
                },
                {
                  "name": "logs",
                  "description": "tail logs and watch output"
                },
                {
                  "name": "execution-shell",
                  "description": "run ad-hoc commands here without interrupting the other panes"
                }
              ]
            }
          }
        ]
      }
    ]
  }
}
