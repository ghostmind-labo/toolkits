{
  "id": "H8eW8uubGfEY",
  "name": "toolkits",
  "type": "app",
  "routines": {
    "init_tmux": "run tmux init toolkits",
    "attach_tmux": "run tmux attach toolkits",
    "terminate_tmux": "run tmux terminate toolkits",
    "claude_marketplace_add": "claude plugin marketplace add ./",
    "claude_marketplace_add_remote": "claude plugin marketplace add ghostmind-labo/toolkits"
  },
  "tmux": {
    "sessions": [
      {
        "name": "toolkits",
        "windows": [
          {
            "name": "claude",
            "layout": "compact",
            "compact": {
              "type": "single",
              "panes": {
                "main": "Claude"
              }
            }
          },
          {
            "name": "shell",
            "layout": "compact",
            "compact": {
              "type": "single",
              "panes": {
                "main": "$SHELL"
              }
            }
          }
        ]
      }
    ]
  }
}
